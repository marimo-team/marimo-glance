{
  "name": "@marimo/extension",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "lint": "oxlint .",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "clean": "rm -rf output .wxt",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@marimo/extension-runtime": "workspace:*",
    "@marimo/host-github": "workspace:*",
    "@marimo/host-gitlab": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "shadcn": "4.20.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  }
}
